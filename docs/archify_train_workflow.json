    { "id": "align", "lane": "data", "col": 1, "type": "backend", "label": "整图对齐", "sublabel": "align.py · Harris+RANSAC 单应", "tag": "内点 ≥ 50", "width": 150 },
    { "id": "quarantine", "lane": "data", "col": 1, "type": "security", "label": "失败隔离", "sublabel": "align_failed/ 移出", "width": 132, "yOffset": 76 },
