{
  // 全局随机种子:底图 8:2 划分与每 epoch 贴图的随机源(同 seed 同结果)
  "seed": 20260927,

  // [迷你工程常量] 切块边长 px —— 256 是 2GB 显存的关键(真工程为 512)
  "tile_size": 256,

  // 轮次与早停(与真工程同口径:上限 20,练满 8 轮后 val_loss 连续 4 轮不降早停)
  "epochs": 20,
  "min_epochs": 8,
  "early_stop_patience": 4,

  // 优化器(迷你 U-Net 全参数训练)
  "batch_size": 4,
  "lr": 3e-4,
  "weight_decay": 1e-4,

  // 损失 = Sigmoid Focal(α=0.4, γ=2.0) + Dice × 3(与真工程同权重)
  "dice_weight": 3.0,
  "focal_alpha": 0.4,
  "focal_gamma": 2.0,

  // 精度与设备:auto = cuda 可用时 bf16(Ampere+)否则 fp16;再否则 cpu
  "amp": "auto",
  "device": "auto",

  // 目录:datasets/{产品}/{点位}/ 与 models/{产品}/(deploy 契约与真工程一致)
  "data_dir": "datasets",
  "models_dir": "models",

  // 训练池 8:2 早停验证划分(固定种子)
  "val_ratio": 0.2,

  // 泊松克隆掩码外扩 5~7px(盖过 OpenCV 内部 4px 腐蚀,保住缺陷边缘梯度)
  "paste_dilate_min": 5,
  "paste_dilate_max": 7
}
